---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { Font } from 'astro:assets';
import '../styles/essay.css';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, subtitle, pubDate, updatedDate, heroImage, canonicalURL } =
	Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} canonicalURL={canonicalURL} />
		<Font cssVariable="--font-newsreader" preload />
		<style>
			/* Structural only — typography/palette live in essay.css */
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				max-width: min(1080px, 100%);
				height: auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
		</style>
	</head>

	<body class="essay-surface">
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{
						heroImage && (
							<Image
								src={heroImage}
								alt=""
								widths={[480, 720, 1080, 1440]}
								sizes="(max-width: 720px) 100vw, 1080px"
							/>
						)
					}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						{subtitle && <p class="subtitle">{subtitle}</p>}
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
		<script>
			// Footnote popovers — show the note in a card at the marker (Substack-style)
			// instead of jumping to the end. The end-of-page list remains the no-JS fallback.
			const prose = document.querySelector('.prose');
			let pop: HTMLElement | null = null;

			function close() {
				pop?.remove();
				pop = null;
				document.removeEventListener('click', onDocClick);
				document.removeEventListener('keydown', onKey);
			}
			function onDocClick(e: MouseEvent) {
				const t = e.target as HTMLElement;
				if (pop && !pop.contains(t) && !t.closest('a[data-footnote-ref]')) close();
			}
			function onKey(e: KeyboardEvent) {
				if (e.key === 'Escape') close();
			}

			document.querySelectorAll<HTMLAnchorElement>('a[data-footnote-ref]').forEach((ref) => {
				ref.addEventListener('click', (e) => {
					e.preventDefault();
					const id = ref.getAttribute('href')?.slice(1) ?? '';
					const note = document.getElementById(id);
					if (!note || !prose) return;
					if (pop?.dataset.for === id) return close(); // second click toggles off
					close();

					pop = document.createElement('aside');
					pop.className = 'fn-popover';
					pop.dataset.for = id;
					pop.setAttribute('role', 'note');

					const num = document.createElement('span');
					num.className = 'fn-popover-num';
					num.textContent = ref.textContent ?? '';

					const x = document.createElement('button');
					x.className = 'fn-popover-close';
					x.setAttribute('aria-label', 'Close footnote');
					x.textContent = '×';
					x.addEventListener('click', close);

					const content = note.cloneNode(true) as HTMLElement;
					content.querySelectorAll('[data-footnote-backref]').forEach((a) => a.remove());

					pop.append(num, x, ...content.childNodes);
					prose.appendChild(pop);
					const proseRect = prose.getBoundingClientRect();
					const refRect = ref.getBoundingClientRect();
					pop.style.top = `${refRect.bottom - proseRect.top + 10}px`;

					document.addEventListener('click', onDocClick);
					document.addEventListener('keydown', onKey);
				});
			});
		</script>
	</body>
</html>
