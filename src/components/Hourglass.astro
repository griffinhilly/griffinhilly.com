---
// Marks work that isn't in a finished state. Icon only by default; `label` adds the words.
interface Props {
	label?: boolean;
}
const { label = false } = Astro.props;
---

<span class="hg" title="In progress">
	<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
		<path
			fill="none"
			stroke="currentColor"
			stroke-width="1.4"
			stroke-linecap="round"
			stroke-linejoin="round"
			d="M4 1.75h8M4 14.25h8M5 1.75c0 3 6 3.6 6 6.25S5 11.25 5 14.25M11 1.75c0 3-6 3.6-6 6.25s6 3.25 6 6.25"></path>
		<path fill="currentColor" d="M6.4 13.4c.5-1.3 2.7-1.3 3.2 0z"></path>
	</svg>
	{label ? <span>In progress</span> : <span class="sr-only">In progress</span>}
</span>

<style>
	.hg {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		color: var(--wip);
		font: 400 0.74rem/1 var(--f-mono);
		white-space: nowrap;
	}
</style>
