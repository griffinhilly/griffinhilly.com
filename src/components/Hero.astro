---
interface Props {
	name: string;
	positioning: string; // the one-line positioning statement (Griffin's words)
	bio?: string[]; // short about lines, one per line break (Griffin's words)
	now?: string; // small status pill above the name, e.g. what he's working on
}
const { name, positioning, bio, now } = Astro.props;
---

<section class="hero">
	{now && <span class="now mono"><b aria-hidden="true"></b>{now}</span>}
	<h1>{name}</h1>
	<p class="lede">{positioning}</p>
	{bio && <p class="bio">{bio.map((line, i) => <>{i > 0 && <br />}{line}</>)}</p>}
</section>

<style>
	.hero {
		padding-block: 64px 48px;
	}
	.now {
		display: inline-flex;
		gap: 8px;
		align-items: center;
		border: 1px solid var(--rule);
		border-radius: 999px;
		padding: 4px 12px;
		background: var(--surface);
	}
	.now b {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 0 4px var(--glow);
	}
	h1 {
		font-size: clamp(2.6rem, 7vw, 4.4rem);
		line-height: 1.02;
		letter-spacing: -0.035em;
		margin: 22px 0 14px;
	}
	.lede {
		font-size: clamp(1.1rem, 2.4vw, 1.35rem);
		color: var(--ink2);
		max-width: 34ch;
		margin: 0;
		text-wrap: balance;
	}
	.bio {
		margin: 28px 0 0;
		color: var(--ink3);
		font-size: 0.95rem;
		max-width: 52ch;
	}
	@media (max-width: 640px) {
		.hero {
			padding-block: 40px 32px;
		}
	}
</style>
