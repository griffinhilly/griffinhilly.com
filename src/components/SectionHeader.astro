---
interface Props {
	title: string;
	href?: string; // optional "see all →" link
	linkLabel?: string;
}
const { title, href, linkLabel = 'See all →' } = Astro.props;
---

<div class="section-header">
	<h2>{title}</h2>
	{href && <a href={href}>{linkLabel}</a>}
</div>

<style>
	.section-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1em;
		padding-bottom: 10px;
		margin-bottom: 6px;
		border-bottom: 1px solid var(--rule);
	}
	.section-header h2 {
		font: 500 0.82rem/1.2 var(--f-ui);
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--ink3);
	}
	.section-header a {
		flex: none;
		font-size: 0.88rem;
		color: var(--ink2);
		text-decoration: none;
		white-space: nowrap;
	}
	.section-header a:hover {
		color: var(--accent);
	}
</style>
