---
import HeaderLink from './HeaderLink.astro';
---

<header class="nav">
	<a class="mark" href="/" aria-label="Griffin Hilly, home"><i aria-hidden="true"></i><span>Griffin Hilly</span></a>
	<nav class="links" aria-label="Main">
		<HeaderLink href="/">Home</HeaderLink>
		<HeaderLink href="/blog">Writing</HeaderLink>
		<HeaderLink href="/projects">Projects</HeaderLink>
		<HeaderLink href="/singular">Singular</HeaderLink>
	</nav>
	<button class="tbtn" type="button" data-theme-toggle aria-label="Switch between light and dark">
		<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1zm0 1.5v11a5.5 5.5 0 0 1 0-11z"></path></svg>
	</button>
</header>

<script>
	document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) =>
		b.addEventListener('click', () => {
			const root = document.documentElement;
			const cur = root.dataset.theme || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
			const next = cur === 'dark' ? 'light' : 'dark';
			root.dataset.theme = next;
			try {
				localStorage.setItem('theme', next);
			} catch (e) {}
		}),
	);
</script>

<style>
	.nav {
		max-width: 880px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding-block: 20px;
	}
	.mark {
		display: flex;
		align-items: center;
		gap: 10px;
		text-decoration: none;
		font-weight: 600;
		letter-spacing: -0.01em;
	}
	.mark i {
		width: 22px;
		height: 22px;
		border-radius: 6px;
		display: block;
		background: conic-gradient(from 200deg, var(--s4), var(--s5), var(--s1), var(--s4));
	}
	.links {
		display: flex;
		gap: 2px;
		padding: 4px;
		border: 1px solid var(--rule);
		border-radius: 999px;
		background: var(--surface);
	}
	.links :global(a) {
		text-decoration: none;
		font-size: 0.88rem;
		color: var(--ink2);
		padding: 5px 12px;
		border-radius: 999px;
	}
	.links :global(a.active),
	.links :global(a:hover) {
		background: var(--raise);
		color: var(--ink);
	}
	.tbtn {
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		border: 1px solid var(--rule);
		border-radius: 999px;
		background: var(--surface);
		color: var(--ink2);
		cursor: pointer;
	}
	.tbtn:hover {
		color: var(--ink);
	}
	@media (max-width: 640px) {
		.mark span {
			display: none;
		}
		.links :global(a) {
			padding: 5px 9px;
			font-size: 0.82rem;
		}
	}
</style>
