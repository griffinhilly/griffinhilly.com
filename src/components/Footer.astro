---
const today = new Date();
---

<footer>
	<div class="social-links">
		<a href="https://github.com/griffinhilly" target="_blank" rel="noopener">
			<span class="sr-only">GitHub</span>
			<svg viewBox="0 0 16 16" aria-hidden="true" width="28" height="28"
				><path
					fill="currentColor"
					d="M11.19 12.195c2.016-.24 3.77-1.475 3.99-2.603.348-1.778.32-4.339.32-4.339 0-3.47-2.286-4.488-2.286-4.488C12.062.238 10.083.017 8.027 0h-.05C5.92.017 3.942.238 2.79.765c0 0-2.285 1.017-2.285 4.488l-.002.662c-.004.64-.007 1.35.011 2.091.083 3.394.626 6.74 3.78 7.57 1.454.383 2.703.463 3.709.408 1.823-.1 2.847-.647 2.847-.647l-.06-1.317s-1.303.41-2.767.36c-1.45-.05-2.98-.156-3.215-1.928a3.614 3.614 0 0 1-.033-.496s1.424.346 3.228.428c1.103.05 2.137-.064 3.188-.189zm1.613-2.47H11.13v-4.08c0-.859-.364-1.295-1.091-1.295-.804 0-1.207.517-1.207 1.541v2.233H7.168V5.89c0-1.024-.403-1.541-1.207-1.541-.727 0-1.091.436-1.091 1.296v4.079H3.197V5.522c0-.859.22-1.541.66-2.046.456-.505 1.052-.764 1.793-.764.856 0 1.504.328 1.933.983L8 4.39l.417-.695c.429-.655 1.077-.983 1.934-.983.74 0 1.336.259 1.791.764.442.505.661 1.187.661 2.046v4.203z"
				></path></svg
			>
		</a>
		<a href="/rss.xml" aria-label="RSS feed">
			<span class="sr-only">RSS</span>
			<svg viewBox="0 0 16 16" aria-hidden="true" width="26" height="26"
				><path
					fill="currentColor"
					d="M2 11.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3zM1 5.5A1 1 0 0 1 2 4.5 9.5 9.5 0 0 1 11.5 14a1 1 0 1 1-2 0A7.5 7.5 0 0 0 2 6.5a1 1 0 0 1-1-1zM1 1.5a1 1 0 0 1 1-1A13.5 13.5 0 0 1 15.5 14a1 1 0 1 1-2 0A11.5 11.5 0 0 0 2 2.5a1 1 0 0 1-1-1z"
				></path></svg
			>
		</a>
	</div>
	<div class="copyright">&copy; {today.getFullYear()} Griffin Hilly</div>
</footer>
<style>
	footer {
		padding: 2.5em 1em 4em 1em;
		border-top: 1px solid var(--border);
		background: var(--bg);
		color: var(--text-muted);
		text-align: center;
	}
	.social-links {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 1.25em;
		margin-bottom: 0.75em;
	}
	.social-links a {
		display: flex;
		text-decoration: none;
		color: var(--text-muted);
	}
	.social-links a:hover {
		color: var(--accent);
	}
	.copyright {
		font-size: 0.9rem;
	}
</style>
