---
const today = new Date();
---

<footer>
	<span class="mono">&copy; {today.getFullYear()} Griffin Hilly</span>
	<nav class="mono" aria-label="Elsewhere">
		<a href="/rss.xml">RSS</a>
		<a href="https://github.com/griffinhilly" target="_blank" rel="noopener">GitHub</a>
		<a href="https://x.com/GriffinHilly" target="_blank" rel="noopener">X</a>
		<a href="https://abundanceagendad.substack.com" target="_blank" rel="noopener">Substack</a>
	</nav>
</footer>

<style>
	footer {
		max-width: 880px;
		margin: 40px auto 0;
		padding-block: 24px 40px;
		border-top: 1px solid var(--rule);
		display: flex;
		justify-content: space-between;
		gap: 12px;
		flex-wrap: wrap;
	}
	nav {
		display: flex;
		gap: 16px;
	}
	a {
		color: var(--ink3);
		text-decoration: none;
	}
	a:hover {
		color: var(--accent);
	}
</style>
