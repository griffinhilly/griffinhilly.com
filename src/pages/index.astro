---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import EssayListItem from '../components/EssayListItem.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ProjectTiers from '../components/ProjectTiers.astro';
import ResearchList from '../components/ResearchList.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<Hero
				name="Griffin Hilly"
				now="Now: AI safety research"
				positioning="Finding my comparative advantage on an uncertain frontier."
				bio={[
					'Quant researcher. Amateur philosopher. Eternal student.',
					'Husband to Madi Hilly. Father of two and counting. Proud Chicagoan.',
				]}
			/>

			<ResearchList />

			<ProjectTiers allLink home />

			<section class="sect">
				<SectionHeader title="Writing" href="/blog" linkLabel="All writing →" />
				{
					posts.map((post) => (
						<EssayListItem
							href={`/blog/${post.id}/`}
							title={post.data.title}
							description={post.data.subtitle ?? post.data.description}
							pubDate={post.data.pubDate}
						/>
					))
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
