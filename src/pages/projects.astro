---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ProjectTiers from '../components/ProjectTiers.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Projects · ${SITE_TITLE}`} description="Projects by Griffin Hilly." />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>Projects</h1>
				<p>Things I've built and things I'm building.</p>
			</section>
			<ProjectTiers />
		</main>
		<Footer />
		<style>
			.intro {
				padding-block: 48px 8px;
			}
			.intro h1 {
				font-size: clamp(2.2rem, 6vw, 3.2rem);
				letter-spacing: -0.03em;
				line-height: 1.05;
			}
			.intro p {
				color: var(--ink2);
				font-size: 1.1rem;
				margin: 12px 0 0;
			}
		</style>
	</body>
</html>
